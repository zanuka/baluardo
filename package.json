{
  "name": "vastion",
  "private": true,
  "version": "0.0.0",
  "description": "Mission operations console for a fictional deep-space hardware provider",
  "author": "zanuka",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "cypress",
      "esbuild",
      "msw"
    ]
  },
  "scripts": {
    "dev": "vite --mode api",
    "dev:api": "vite --mode api",
    "dev:msw": "vite --mode msw",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "start-server-and-test dev:msw http://localhost:5173 'cypress run --e2e'",
    "cypress:component": "cypress run --component",
    "cypress:open": "cypress open",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "ofetch": "^1.4.1",
    "pinia": "^3.0.3",
    "vue": "^3.5.40",
    "vue-router": "^4.5.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.1",
    "cypress": "^14.5.4",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.4.0",
    "jsdom": "^26.1.0",
    "msw": "^2.15.0",
    "prettier": "^3.6.2",
    "start-server-and-test": "^2.0.13",
    "tailwindcss": "^4.1.11",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.39.1",
    "vite": "^6.3.5",
    "vitest": "^3.2.4",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.0.5"
  },
  "packageManager": "pnpm@10.11.0",
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
